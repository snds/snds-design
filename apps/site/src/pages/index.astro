---
import Layout from '../components/Layout.astro';
import { CASE_STUDIES } from '../data/caseStudies';
import { url } from '../lib/paths';
---

<Layout>
  <!-- section indicator -->
  <nav class="rail" aria-label="Sections">
    <button class="rail__item" data-target="0" style="--accent:#22d3e0"><span class="rail__lab">Intro</span><span class="rail__tick"></span></button>
    {CASE_STUDIES.map((cs, i) => (
      <button class="rail__item" data-target={i + 1} style={`--accent:${cs.color}`}>
        <span class="rail__lab">{cs.num} {cs.title}</span>
        <span class="rail__tick" />
      </button>
    ))}
  </nav>

  <main id="main-content" class="scroll">
    <section class="panel">
      <div class="panel__in">
        <p class="kicker"><span class="dot"></span>Structure from chaos</p>
        <h1 class="title">Systems for<br /><em>intelligence.</em></h1>
        <p class="lede">
          I build the connective tissue between AI capability and human intent —
          design systems, LLM product surfaces, and the interactive demos that prove them out.
        </p>
        <p class="hud scrollcue">Scroll to explore the work ↓</p>
      </div>
    </section>

    {
      CASE_STUDIES.map((cs) => (
        <section class="panel" id={cs.slug}>
          <div class="panel__in">
            <p class="casenum" style={`color:${cs.color}`}>{cs.num} / 05 · {cs.client}</p>
            <h2 class="casetitle">{cs.title}</h2>
            <p class="caseblurb">{cs.blurb}</p>
            <div class="caserow">
              <span class="swatch" style={`background:${cs.color}`} />
              <a class="caselink" href={url(`/work/${cs.slug}`)}>Open case study →</a>
              <span class="hud demo">live demo · soon</span>
            </div>
          </div>
        </section>
      ))
    }
  </main>
</Layout>

<style>
  /* section rail */
  .rail {
    position: fixed;
    right: var(--snds-grid-margin);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: var(--snds-space-3);
    align-items: flex-end;
  }
  .rail__item {
    display: flex; align-items: center; justify-content: flex-end; gap: var(--snds-space-3);
    background: none; border: none; cursor: pointer; padding: 2px 0;
  }
  .rail__tick { flex: none; width: 24px; height: 1px; background: var(--snds-color-border); transition: width 200ms, background 200ms; }
  .rail__lab {
    text-align: right;
    font-family: var(--snds-font-mono); font-size: var(--snds-fontSize-micro);
    letter-spacing: var(--snds-letterSpacing-wide); text-transform: uppercase;
    color: var(--snds-color-fgSubtle);
    opacity: 0; transform: translateX(8px); transition: opacity 180ms, transform 180ms, color 180ms;
  }
  .rail__item:hover .rail__lab { opacity: 1; transform: translateX(0); }
  .rail__item[aria-current='true'] .rail__tick { width: 40px; background: var(--accent); }
  .rail__item[aria-current='true'] .rail__lab { opacity: 1; transform: translateX(0); color: var(--snds-color-fg); }
  @media (max-width: 720px) { .rail { display: none; } }

  .scroll { position: relative; z-index: 2; }
  .panel {
    min-height: 100vh; max-width: var(--snds-grid-maxWidth);
    margin-inline: auto; padding-inline: var(--snds-grid-margin);
    display: grid; align-items: center;
  }
  .panel__in { max-width: 48ch; }

  .kicker {
    display: inline-flex; align-items: center; gap: var(--snds-space-2);
    font-family: var(--snds-font-mono); font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-wide); text-transform: uppercase;
    color: var(--snds-color-primaryFg); margin-bottom: var(--snds-space-5);
  }
  .kicker .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--snds-color-signal); box-shadow: 0 0 12px var(--snds-color-signal); }
  .title { font-size: clamp(3.5rem, 11vw, 9.5rem); line-height: 0.92; letter-spacing: -0.045em; font-weight: 500; text-wrap: balance; }
  .casetitle { font-weight: 500; }
  .title em { font-style: italic; color: var(--snds-color-fgMuted); }
  .lede { max-width: 46ch; margin-top: var(--snds-space-6); color: var(--snds-color-fgMuted); font-size: var(--snds-fontSize-lead); line-height: var(--snds-lineHeight-snug); }

  /* readability oval — blurs + darkens the field behind body copy.
     A radial mask feathers BOTH the dark gradient and the blur so there's
     no sharp edge where the blur stops. */
  .lede, .caseblurb { position: relative; }
  .lede::before, .caseblurb::before {
    content: ''; position: absolute; z-index: -1; inset: -44px -80px;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 72%);
    -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, rgba(0,0,0,0) 72%);
    mask-image: radial-gradient(ellipse at center, #000 35%, rgba(0,0,0,0) 72%);
    pointer-events: none;
  }
  .hud { font-family: var(--snds-font-mono); font-size: var(--snds-fontSize-micro); letter-spacing: var(--snds-letterSpacing-hud); text-transform: uppercase; color: var(--snds-color-fgSubtle); }
  .scrollcue { margin-top: var(--snds-space-8); }

  .casenum { font-family: var(--snds-font-mono); font-size: var(--snds-fontSize-caption); letter-spacing: var(--snds-letterSpacing-hud); text-transform: uppercase; }
  .casetitle { font-size: clamp(2.5rem, 6vw, 4.75rem); line-height: 1.0; letter-spacing: -0.03em; margin: var(--snds-space-2) 0 var(--snds-space-4); }
  .caseblurb { color: var(--snds-color-fgMuted); font-size: var(--snds-fontSize-lead); line-height: var(--snds-lineHeight-snug); max-width: 44ch; }
  .caserow { display: flex; align-items: center; gap: var(--snds-space-5); margin-top: var(--snds-space-6); flex-wrap: wrap; }
  .swatch { width: 14px; height: 14px; border-radius: 2px; }
  .caselink { font-family: var(--snds-font-mono); font-size: var(--snds-fontSize-caption); letter-spacing: var(--snds-letterSpacing-wide); text-transform: uppercase; color: var(--snds-color-fg); border-bottom: 1px solid var(--snds-color-border); padding-bottom: 2px; }
  .caselink:hover { color: var(--snds-color-primaryFg); border-color: var(--snds-color-primaryBorder); }
  .demo { color: var(--snds-color-fgSubtle); }

  @media (max-width: 720px) { .lede, .caseblurb { font-size: var(--snds-fontSize-body); } }
</style>

<script>
  const getLenis = () => (window as unknown as { __lenis?: { scrollTo: (y: number) => void } }).__lenis;

  const update = () => {
    const idx = Math.round(window.scrollY / Math.max(window.innerHeight, 1));
    document.querySelectorAll<HTMLButtonElement>('.rail__item').forEach((el) => {
      el.setAttribute('aria-current', Number(el.dataset.target) === idx ? 'true' : 'false');
    });
  };

  // re-bind on each navigation (rail DOM is recreated); scroll listener once
  const initRail = () => {
    document.querySelectorAll<HTMLButtonElement>('.rail__item').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      el.addEventListener('click', () => {
        const y = Number(el.dataset.target || 0) * window.innerHeight;
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(y);
        else window.scrollTo(0, y);
      });
    });
    update();
  };

  let ticking = false;
  if (!(window as unknown as { __railScroll?: boolean }).__railScroll) {
    (window as unknown as { __railScroll?: boolean }).__railScroll = true;
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(() => { ticking = false; update(); }); ticking = true; }
    }, { passive: true });
  }

  initRail();
  document.addEventListener('astro:page-load', initRail);
</script>
