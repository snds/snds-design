---
import Layout from '../../components/Layout.astro';
import { CASE_STUDIES } from '../../data/caseStudies';
import { url } from '../../lib/paths';
---

<Layout title="Work — SNDS" description="Selected case studies in design systems, AI/LLM product work, and interactive engineering." fieldMode="muted">
  <main id="main-content" class="work">
    <header class="work__head">
      <p class="work__kick">Selected work · 2012 — 2026</p>
      <h1 class="work__title">Work</h1>
      <p class="work__lede">
        Design systems, AI/LLM product surfaces, and the interactive demos that
        prove them out. Live, bespoke rebuilds of each are in production.
      </p>
    </header>

    <ul class="work__list">
      {CASE_STUDIES.map((cs) => (
        <li class="work__item" style={`--accent:${cs.color}`}>
          <a href={url(`/work/${cs.slug}`)} class="work__link">
            <span class="work__num">{cs.num}</span>
            <span class="work__body">
              <span class="work__name">{cs.title}</span>
              <span class="work__sum">{cs.blurb}</span>
            </span>
            <span class="work__dot" aria-hidden="true"></span>
            <span class="work__go">View →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .work {
    max-width: var(--snds-grid-maxWidth);
    margin-inline: auto;
    padding: calc(var(--snds-space-16) + 48px) var(--snds-grid-margin) var(--snds-space-24);
  }
  .work__kick {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--snds-color-fgSubtle);
  }
  .work__title {
    font-size: clamp(3rem, 9vw, 7rem);
    letter-spacing: -0.04em;
    font-weight: 500;
    margin: var(--snds-space-2) 0 var(--snds-space-4);
  }
  .work__lede {
    max-width: 52ch;
    color: var(--snds-color-fgMuted);
    font-size: var(--snds-fontSize-lead);
    line-height: var(--snds-lineHeight-snug);
    margin-bottom: var(--snds-space-12);
  }
  .work__list { list-style: none; border-top: 1px solid var(--snds-color-borderSubtle); }
  .work__item { border-bottom: 1px solid var(--snds-color-borderSubtle); }
  .work__link {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--snds-space-6);
    padding: var(--snds-space-6) var(--snds-space-2);
    transition: background 160ms, padding-left 200ms;
  }
  .work__link:hover { background: var(--snds-color-bgSubtle); padding-left: var(--snds-space-5); }
  .work__num {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    color: var(--accent);
  }
  .work__name {
    display: block;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    letter-spacing: -0.025em;
    color: var(--snds-color-fg);
  }
  .work__sum {
    display: block;
    color: var(--snds-color-fgMuted);
    font-size: var(--snds-fontSize-body);
    max-width: 60ch;
    margin-top: var(--snds-space-1);
  }
  .work__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .work__go {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
  }
  @media (max-width: 640px) {
    .work__link { grid-template-columns: auto 1fr; }
    .work__dot, .work__go { display: none; }
  }
</style>
