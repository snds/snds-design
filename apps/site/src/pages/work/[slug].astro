---
import { getCollection, render } from 'astro:content';
import { X } from '@phosphor-icons/react';
import Layout from '../../components/Layout.astro';
import { CASE_STUDIES } from '../../data/caseStudies';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const idx = CASE_STUDIES.findIndex((c) => c.slug === entry.id);
const cs = CASE_STUDIES[idx];
const prev = CASE_STUDIES[idx - 1];
const next = CASE_STUDIES[idx + 1];
const accent = cs?.color ?? '#22d3e0';

const meta = [
  ['Client', d.client],
  ['Role', d.role],
  ['Year', d.year],
  ['Team', d.team],
  ['Tools', d.tools.join(', ')],
];
---

<Layout title={`${d.title} — SNDS`} description={d.summary} fieldMode="dialog" footer={false}>
  <main id="main-content" class="cs" style={`--accent:${accent}`}>
    <div class="cs__bar">
      <a href={url('/work')} class="cs__back">All work</a>
      <button class="cs__close" type="button" aria-label="Close and return">
        <X size={18} weight="regular" />
      </button>
    </div>

    <header class="cs__head">
      <p class="cs__num">{cs?.num ?? '—'} / 05 · {d.client}</p>
      <h1 class="cs__title">{d.title}</h1>
      <p class="cs__summary">{d.summary}</p>
      <ul class="cs__tags">
        {d.tags.map((t) => <li>{t}</li>)}
      </ul>
    </header>

    <dl class="cs__meta">
      {meta.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>

    {d.metrics.length > 0 && (
      <ul class="cs__metrics">
        {d.metrics.map((m) => (
          <li>
            <span class="cs__metricVal">{m.value}</span>
            <span class="cs__metricLabel">{m.label}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="prose">
      <Content />
    </div>

    <section class="cs__demo" aria-label="Live demo">
      <p class="cs__demoKick">Interactive demo</p>
      {d.demo ? (
        <a class="cs__demoLink" href={d.demo.url} target="_blank" rel="noopener">{d.demo.label} →</a>
      ) : (
        <p class="cs__demoSoon">
          A bespoke, live rebuild of this project — with its own design system and
          components — is in production. Coming soon.
        </p>
      )}
    </section>

    <nav class="cs__pager" aria-label="Case studies">
      {prev ? (
        <a href={url(`/work/${prev.slug}`)} class="cs__pagerLink">
          <span class="cs__pagerDir">← Prev</span>
          <span class="cs__pagerName">{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={url(`/work/${next.slug}`)} class="cs__pagerLink cs__pagerLink--next">
          <span class="cs__pagerDir">Next →</span>
          <span class="cs__pagerName">{next.title}</span>
        </a>
      ) : <span />}
    </nav>
  </main>
</Layout>

<style>
  /* dialog panel — floats over the live field; field shows in the margins */
  .cs {
    position: relative;
    max-width: 820px;
    margin: calc(72px + var(--snds-space-6)) auto var(--snds-space-16);
    background: color-mix(in srgb, var(--snds-color-bgElevated) 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--snds-color-border);
    border-radius: var(--snds-radius-lg);
    padding: var(--snds-space-8) clamp(var(--snds-space-6), 5vw, var(--snds-space-12)) var(--snds-space-12);
  }
  .cs__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--snds-space-6);
  }
  .cs__back {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
  }
  .cs__back:hover { color: var(--snds-color-fg); }
  .cs__close {
    display: grid;
    place-items: center;
    width: 36px; height: 36px;
    color: var(--snds-color-fg);
    background: transparent;
    border: 1px solid var(--snds-color-border);
    border-radius: var(--snds-radius-full);
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }
  .cs__close:hover { color: var(--accent); border-color: var(--accent); }

  .cs__head {
    margin: var(--snds-space-8) 0 var(--snds-space-10);
    border-top: 2px solid var(--accent);
    padding-top: var(--snds-space-6);
  }
  .cs__num {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--accent);
  }
  .cs__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1.0;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin: var(--snds-space-3) 0 var(--snds-space-4);
  }
  .cs__summary {
    font-size: var(--snds-fontSize-lead);
    color: var(--snds-color-fgMuted);
    max-width: 60ch;
    line-height: var(--snds-lineHeight-snug);
  }
  .cs__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--snds-space-2);
    margin-top: var(--snds-space-5);
  }
  .cs__tags li {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
    padding: 3px 8px;
    border: 1px solid var(--snds-color-borderSubtle);
    border-radius: var(--snds-radius-sm);
  }

  .cs__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--snds-space-5);
    padding: var(--snds-space-6) 0;
    border-block: 1px solid var(--snds-color-borderSubtle);
    margin-bottom: var(--snds-space-10);
  }
  .cs__meta dt {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--snds-color-fgSubtle);
    margin-bottom: var(--snds-space-2);
  }
  .cs__meta dd { font-size: var(--snds-fontSize-body); color: var(--snds-color-fg); }

  .cs__metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--snds-color-borderSubtle);
    border: 1px solid var(--snds-color-borderSubtle);
    margin-bottom: var(--snds-space-12);
  }
  .cs__metrics li {
    background: var(--snds-color-bg);
    padding: var(--snds-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--snds-space-2);
  }
  .cs__metricVal {
    font-family: var(--snds-font-display);
    font-size: var(--snds-fontSize-h3);
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .cs__metricLabel {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgSubtle);
  }

  /* MDX prose */
  .prose { max-width: 68ch; }
  .prose :global(p) {
    color: var(--snds-color-fgMuted);
    font-size: var(--snds-fontSize-lead);
    line-height: var(--snds-lineHeight-normal);
    margin-bottom: var(--snds-space-6);
  }
  .prose :global(h2) {
    font-size: var(--snds-fontSize-h3);
    letter-spacing: -0.02em;
    margin: var(--snds-space-12) 0 var(--snds-space-4);
    color: var(--snds-color-fg);
  }
  .prose :global(strong) { color: var(--snds-color-fg); }
  .prose :global(em) { color: var(--snds-color-fg); font-style: italic; }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: var(--snds-space-2) 0 var(--snds-space-2) var(--snds-space-5);
    margin: var(--snds-space-8) 0;
  }
  .prose :global(blockquote p) {
    color: var(--snds-color-fg);
    font-family: var(--snds-font-display);
    font-size: var(--snds-fontSize-h4);
    letter-spacing: -0.01em;
  }

  .cs__demo {
    margin-top: var(--snds-space-16);
    padding: var(--snds-space-8);
    border: 1px dashed var(--snds-color-border);
    border-radius: var(--snds-radius-lg);
    background:
      linear-gradient(color-mix(in srgb, var(--accent) 6%, transparent), transparent);
  }
  .cs__demoKick {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--snds-space-3);
  }
  .cs__demoSoon { color: var(--snds-color-fgMuted); max-width: 52ch; }
  .cs__demoLink {
    font-family: var(--snds-font-mono);
    text-transform: uppercase;
    letter-spacing: var(--snds-letterSpacing-wide);
    color: var(--snds-color-fg);
    border-bottom: 1px solid var(--accent);
  }

  .cs__pager {
    display: flex;
    justify-content: space-between;
    gap: var(--snds-space-6);
    margin-top: var(--snds-space-16);
    padding-top: var(--snds-space-6);
    border-top: 1px solid var(--snds-color-borderSubtle);
  }
  .cs__pagerLink { display: grid; gap: var(--snds-space-1); }
  .cs__pagerLink--next { text-align: right; }
  .cs__pagerDir {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgSubtle);
  }
  .cs__pagerName { color: var(--snds-color-fg); font-size: var(--snds-fontSize-lead); }
  .cs__pagerLink:hover .cs__pagerName { color: var(--accent); }
</style>

<script>
  const HOME = import.meta.env.BASE_URL;
  const bindClose = () => {
    document.querySelectorAll<HTMLButtonElement>('.cs__close').forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = 'true';
      b.addEventListener('click', () => {
        // return to where we came from (restores scroll); else go home
        if (window.history.length > 1) window.history.back();
        else window.location.assign(HOME);
      });
    });
  };
  bindClose();
  document.addEventListener('astro:page-load', bindClose);
</script>
