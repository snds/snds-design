---
import { getCollection, render } from 'astro:content';
import { X } from '@phosphor-icons/react';
import Layout from '../../components/Layout.astro';
import { CASE_STUDIES } from '../../data/caseStudies';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const idx = CASE_STUDIES.findIndex((c) => c.slug === entry.id);
const cs = CASE_STUDIES[idx];
const prev = CASE_STUDIES[idx - 1];
const next = CASE_STUDIES[idx + 1];
const accent = cs?.color ?? '#22d3e0';

const meta = [
  ['Client', d.client],
  ['Role', d.role],
  ['Year', d.year],
  ['Team', d.team],
  ['Tools', d.tools.join(', ')],
];
---

<Layout title={`${d.title} — SNDS`} description={d.summary} fieldMode="dialog" footer={false}>
  <main id="main-content" class="cs" data-node-index={idx} style={`--accent:${accent}`}>
    <header class="cs__head">
      <button class="cs__close" type="button" aria-label="Close project">
        <X size={18} weight="regular" />
      </button>
      <p class="cs__num">{cs?.num ?? '—'} / 05 · {d.client}</p>
      <h1 class="cs__title">{d.title}</h1>
      <p class="cs__summary">{d.summary}</p>
      <ul class="cs__tags">
        {d.tags.map((t) => <li>{t}</li>)}
      </ul>
    </header>

    <dl class="cs__meta">
      {meta.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>

    {d.metrics.length > 0 && (
      <ul class="cs__metrics">
        {d.metrics.map((m) => (
          <li>
            <span class="cs__metricVal">{m.value}</span>
            <span class="cs__metricLabel">{m.label}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="prose">
      <Content />
    </div>

    <section class="cs__demo" aria-label="Live demo">
      <p class="cs__demoKick">Interactive demo</p>
      {d.demo ? (
        <a class="cs__demoLink" href={d.demo.url} target="_blank" rel="noopener">{d.demo.label} →</a>
      ) : (
        <p class="cs__demoSoon">
          A bespoke, live rebuild of this project — with its own design system and
          components — is in production. Coming soon.
        </p>
      )}
    </section>

    <nav class="cs__pager" aria-label="Case studies">
      {prev ? (
        <a href={url(`/work/${prev.slug}`)} class="cs__pagerLink" data-astro-history="replace">
          <span class="cs__pagerDir">← Prev</span>
          <span class="cs__pagerName">{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={url(`/work/${next.slug}`)} class="cs__pagerLink cs__pagerLink--next" data-astro-history="replace">
          <span class="cs__pagerDir">Next →</span>
          <span class="cs__pagerName">{next.title}</span>
        </a>
      ) : <span />}
    </nav>
  </main>
</Layout>

<style>
  /* dialog panel — floats over the live field; field shows in the margins */
  .cs {
    position: relative;
    overflow: hidden;     /* clip the radial glow to the rounded panel */
    isolation: isolate;   /* scope the glow layer's stacking to the panel */
    max-width: 820px;
    margin: calc(72px + var(--snds-space-6)) auto var(--snds-space-16);
    /* neutral frosted glass — the field whispers through the blur */
    background: color-mix(in srgb, var(--snds-color-bg) var(--snds-glass-opacity), transparent);
    -webkit-backdrop-filter: blur(var(--snds-glass-blur)) saturate(var(--snds-glass-saturate));
    backdrop-filter: blur(var(--snds-glass-blur)) saturate(var(--snds-glass-saturate));
    border: 1px solid var(--snds-color-border);
    border-radius: var(--snds-radius-lg);
    box-shadow: 0 32px 90px -34px rgba(0, 0, 0, 0.55);
    padding: var(--snds-space-8) clamp(var(--snds-space-6), 5vw, var(--snds-space-12)) var(--snds-space-12);
  }
  /* The node's light caught locally on the glass: a radial glow at the node's
     projected position (--glow-x/--glow-y, panel-relative). Screen blend so it
     reads as LIGHT (additive), not opaque paint; --glow-strength dims it with
     the node's distance from the glass; falls off radially. */
  .cs::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    mix-blend-mode: screen;
    opacity: var(--glow-on, 0);
    transition: opacity 400ms ease;
    background:
      /* hot core — persists as a hotspot even when the node is far back */
      radial-gradient(
        var(--snds-glow-core-size) var(--snds-glow-core-size) at var(--glow-x, 50%) var(--glow-y, -10%),
        color-mix(in srgb, var(--glow-color, var(--accent)) calc(var(--snds-glow-core) * max(var(--snds-glow-floor), var(--glow-strength, 1))), transparent) 0%,
        transparent 100%
      ),
      /* diffuse halo — spreads and fades fully with distance */
      radial-gradient(
        var(--snds-glow-size) var(--snds-glow-size) at var(--glow-x, 50%) var(--glow-y, -10%),
        color-mix(in srgb, var(--glow-color, var(--accent)) calc(var(--snds-glow-intensity) * var(--glow-strength, 1)), transparent) 0%,
        transparent 100%
      );
  }
  /* tinted border — colour the frame only where the node is near it, fading
     around (radial mask) and dimming with distance (--glow-strength). */
  .cs::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    padding: 1px; /* ring thickness */
    border-radius: inherit;
    mix-blend-mode: screen; /* hottest border segment reads as brighter light */
    opacity: var(--glow-on, 0);
    transition: opacity 400ms ease;
    /* a colour gradient ALONG the frame: whitens toward the hot core (only when
       the node is near the edge), node-colour spreading, dim base all around. */
    background: radial-gradient(
      var(--snds-glow-border-size) var(--snds-glow-border-size) at var(--glow-x, 50%) var(--glow-y, -10%),
      color-mix(in srgb, #fff calc(var(--snds-glow-border-hot) * max(var(--snds-glow-floor), var(--glow-strength, 1))), var(--glow-color, var(--accent))) 0%,
      color-mix(in srgb, var(--glow-color, var(--accent)) calc(var(--snds-glow-border) * max(var(--snds-glow-floor), var(--glow-strength, 1))), transparent) 28%,
      color-mix(in srgb, var(--glow-color, var(--accent)) calc(var(--snds-glow-border) * var(--snds-glow-border-floor) * max(var(--snds-glow-floor), var(--glow-strength, 1))), transparent) 100%
    );
    /* clip the gradient to the 1px ring (border-box minus content-box) */
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
  .cs > * { position: relative; z-index: 1; } /* content between glow and border */
  /* close — anchored top-right of the hero header */
  .cs__close {
    position: absolute;
    top: var(--snds-space-5);
    right: 0;
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    color: var(--snds-color-fg);
    background: transparent;
    border: none; /* ghost */
    border-radius: var(--snds-radius-full);
    cursor: pointer;
    transition: background 120ms, color 120ms;
  }
  .cs__close:hover {
    background: color-mix(in srgb, var(--snds-color-fg) 12%, transparent);
    color: var(--accent);
  }

  .cs__head {
    position: relative;
    margin: 0 0 var(--snds-space-10);
    border-top: 2px solid var(--accent);
    /* right gutter reserves space for the absolutely-placed close button */
    padding: var(--snds-space-6) var(--snds-space-12) 0 0;
  }
  .cs__num {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--accent);
  }
  /* Tungsten display — title at the top of the project dialog. */
  .cs__title {
    font-family: var(--snds-font-heading);
    text-transform: uppercase;
    font-weight: 600;
    font-size: clamp(3.25rem, 8.5vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: 0;
    overflow-wrap: break-word;
    margin: var(--snds-space-3) 0 var(--snds-space-4);
  }
  @media (max-width: 560px) {
    .cs__title { font-size: 3.9rem; }
  }
  .cs__summary {
    font-size: var(--snds-fontSize-lead);
    color: var(--snds-color-fgMuted);
    max-width: 60ch;
    line-height: var(--snds-lineHeight-snug);
  }
  .cs__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--snds-space-2);
    margin-top: var(--snds-space-5);
  }
  .cs__tags li {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    font-weight: var(--snds-weight-regular);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
    padding: 3px 8px;
    border: 1px solid var(--snds-color-borderSubtle);
    border-radius: var(--snds-radius-sm);
  }

  .cs__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--snds-space-5);
    padding: var(--snds-space-6) 0;
    border-block: 1px solid var(--snds-color-borderSubtle);
    margin-bottom: var(--snds-space-10);
  }
  .cs__meta dt {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    font-weight: var(--snds-weight-regular);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
    margin-bottom: var(--snds-space-2);
  }
  .cs__meta dd { font-size: var(--snds-fontSize-body); color: var(--snds-color-fg); }

  .cs__metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--snds-color-borderSubtle);
    border: 1px solid var(--snds-color-borderSubtle);
    margin-bottom: var(--snds-space-12);
  }
  .cs__metrics li {
    /* near-black at 60% (theme-aware bg) — dark, low-opacity so the glow reads through */
    background: color-mix(in srgb, var(--snds-color-bg) 60%, transparent);
    padding: var(--snds-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--snds-space-2);
  }
  .cs__metricVal {
    font-family: var(--snds-font-display);
    font-size: var(--snds-fontSize-h3);
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .cs__metricLabel {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    font-weight: var(--snds-weight-regular);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
  }

  /* MDX prose */
  .prose { max-width: 68ch; }
  .prose :global(p) {
    color: var(--snds-color-fgMuted);
    font-size: var(--snds-fontSize-lead);
    line-height: var(--snds-lineHeight-normal);
    margin-bottom: var(--snds-space-6);
  }
  .prose :global(h2) {
    font-size: var(--snds-fontSize-h3);
    letter-spacing: -0.02em;
    margin: var(--snds-space-12) 0 var(--snds-space-4);
    color: var(--snds-color-fg);
  }
  .prose :global(strong) { color: var(--snds-color-fg); }
  .prose :global(em) { color: var(--snds-color-fg); font-style: italic; }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: var(--snds-space-2) 0 var(--snds-space-2) var(--snds-space-5);
    margin: var(--snds-space-8) 0;
  }
  .prose :global(blockquote p) {
    color: var(--snds-color-fg);
    font-family: var(--snds-font-display);
    font-size: var(--snds-fontSize-h4);
    letter-spacing: -0.01em;
  }

  .cs__demo {
    margin-top: var(--snds-space-16);
    padding: var(--snds-space-8);
    border: 1px dashed var(--snds-color-border);
    border-radius: var(--snds-radius-lg);
    background:
      linear-gradient(color-mix(in srgb, var(--accent) 6%, transparent), transparent);
  }
  .cs__demoKick {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-caption);
    letter-spacing: var(--snds-letterSpacing-hud);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--snds-space-3);
  }
  .cs__demoSoon { color: var(--snds-color-fgMuted); max-width: 52ch; }
  .cs__demoLink {
    font-family: var(--snds-font-mono);
    text-transform: uppercase;
    letter-spacing: var(--snds-letterSpacing-wide);
    color: var(--snds-color-fg);
    border-bottom: 1px solid var(--accent);
  }

  .cs__pager {
    display: flex;
    justify-content: space-between;
    gap: var(--snds-space-6);
    margin-top: var(--snds-space-16);
    padding-top: var(--snds-space-6);
    border-top: 1px solid var(--snds-color-borderSubtle);
  }
  .cs__pagerLink { display: grid; gap: var(--snds-space-1); }
  .cs__pagerLink--next { text-align: right; }
  .cs__pagerDir {
    font-family: var(--snds-font-mono);
    font-size: var(--snds-fontSize-micro);
    font-weight: var(--snds-weight-regular);
    letter-spacing: var(--snds-letterSpacing-wide);
    text-transform: uppercase;
    color: var(--snds-color-fgMuted);
  }
  .cs__pagerName { color: var(--snds-color-fg); font-size: var(--snds-fontSize-lead); }
  .cs__pagerLink:hover .cs__pagerName { color: var(--accent); }

  /* Vivid accents pass AA on the dark panel but not the light one — darken
     accent TEXT toward the foreground in light mode only. Non-text accents
     (the head rule, demo gradient) keep the pure hue. */
  :global(html[data-theme='light']) .cs__num,
  :global(html[data-theme='light']) .cs__metricVal,
  :global(html[data-theme='light']) .cs__demoKick,
  :global(html[data-theme='light']) .cs__close:hover,
  :global(html[data-theme='light']) .cs__pagerLink:hover .cs__pagerName {
    color: color-mix(in srgb, var(--accent) 50%, var(--snds-color-fg));
  }
</style>

<script>
  const HOME = import.meta.env.BASE_URL;

  // Return to where we came from (restores scroll); else go home.
  const closeDialog = () => {
    if (window.history.length > 1) window.history.back();
    else window.location.assign(HOME);
  };

  const bindClose = () => {
    document.querySelectorAll<HTMLButtonElement>('.cs__close').forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = 'true';
      b.addEventListener('click', closeDialog);
    });
  };

  // Click anywhere outside the dialog panel dismisses it. The persistent
  // header (theme toggle, nav) is excluded so its controls keep working; the
  // field/backdrop is fair game. Guarded by `.cs` so it stays inert on pages
  // without a dialog, and bound once to survive view transitions.
  const onOutsideClick = (e: MouseEvent) => {
    const panel = document.querySelector('.cs');
    if (!panel) return; // not a dialog page
    if (document.querySelector('dialog[open]')) return; // help overlay is open
    const t = e.target;
    if (!(t instanceof Element)) return;
    if (t.closest('.cs') || t.closest('header') || t.closest('dialog')) return;
    closeDialog();
  };

  // Keyboard: Esc closes, ←/→ page to prev/next project (via the pager links,
  // so navigation keeps the view transition). Bound once; inert off-dialog and
  // deferred to the help overlay when it's open.
  const onDialogKey = (e: KeyboardEvent) => {
    if (!document.querySelector('.cs')) return;
    if (document.querySelector('dialog[open]')) return;
    const t = e.target;
    if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      closeDialog();
    } else if (e.key === 'ArrowLeft') {
      const prev = document.querySelector<HTMLAnchorElement>('.cs__pager a.cs__pagerLink:not(.cs__pagerLink--next)');
      if (prev) { e.preventDefault(); prev.click(); }
    } else if (e.key === 'ArrowRight') {
      const next = document.querySelector<HTMLAnchorElement>('.cs__pagerLink--next');
      if (next) { e.preventDefault(); next.click(); }
    }
  };

  bindClose();
  if (!(window as unknown as { __csOutsideBound?: boolean }).__csOutsideBound) {
    (window as unknown as { __csOutsideBound?: boolean }).__csOutsideBound = true;
    document.addEventListener('click', onOutsideClick);
    document.addEventListener('keydown', onDialogKey);
  }
  document.addEventListener('astro:page-load', bindClose);
</script>
