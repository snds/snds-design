---
// Accessible toggle switch (ARIA switch pattern). Stateless markup — the
// consumer wires clicks and reflects state via aria-checked. Labelled by a
// visible element passed as `labelledby`.
interface Props {
  id: string;
  labelledby: string;
  checked?: boolean;
}
const { id, labelledby, checked = false } = Astro.props;
---

<button
  type="button"
  id={id}
  class="switch"
  role="switch"
  aria-checked={checked ? 'true' : 'false'}
  aria-labelledby={labelledby}
>
  <span class="switch__track"><span class="switch__thumb"></span></span>
</button>

<style>
  .switch {
    flex: none;
    display: inline-flex;
    padding: 4px;
    background: none;
    border: none;
    border-radius: var(--snds-radius-full);
    cursor: pointer;
  }
  .switch__track {
    display: flex;
    align-items: center;
    width: 40px;
    height: 22px;
    padding: 2px;
    border-radius: var(--snds-radius-full);
    background: var(--snds-color-bgActive);
    border: 1px solid var(--snds-color-border);
    transition: background 140ms, border-color 140ms;
  }
  .switch__thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--snds-color-fgMuted);
    transition: transform 140ms, background 140ms;
  }
  .switch[aria-checked='true'] .switch__track {
    background: var(--snds-color-primary);
    border-color: var(--snds-color-primary);
  }
  .switch[aria-checked='true'] .switch__thumb {
    transform: translateX(18px);
    background: var(--snds-color-fgOnAccent);
  }
  .switch:focus-visible {
    outline: 2px solid var(--snds-color-borderFocus);
    outline-offset: 2px;
  }
</style>
