---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import HeroCanvas from '../r3f/HeroCanvas';

interface Props {
  title?: string;
  description?: string;
  footer?: boolean;
  /** 'home' = interactive field; 'dialog' = field keeps simulating behind a
      dialog overlay (calm camera, no interaction). */
  fieldMode?: 'home' | 'dialog';
}

const {
  title = 'SNDS — AI, LLMs & Design Systems',
  description = 'Sean Sands — design systems, AI/LLM product work, and interactive engineering.',
  footer = true,
  fieldMode = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-field={fieldMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <ClientRouter />
    <script is:inline>
      // apply stored theme before paint + re-apply after each view transition
      const applyTheme = () => {
        try {
          const t = localStorage.getItem('snds-theme');
          if (t) document.documentElement.dataset.theme = t;
        } catch (e) {}
      };
      // motion preference, pre-paint (no flash). Explicit 'full' overrides the
      // OS preference; otherwise the OS prefers-reduced-motion wins.
      const applyMotionAttr = () => {
        try {
          const o = localStorage.getItem('snds-motion');
          const reduced = o === 'reduce'
            || (o !== 'full' && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
          document.documentElement.dataset.motion = reduced ? 'reduce' : 'full';
        } catch (e) {}
      };
      applyTheme();
      applyMotionAttr();
      document.addEventListener('astro:after-swap', () => { applyTheme(); applyMotionAttr(); });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- persistent across navigations -->
    <div class="field" transition:persist="field" aria-hidden="true">
      <HeroCanvas client:only="react" />
    </div>
    <div class="field-mute" transition:persist="field-mute" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <!-- header persists across navigations → unaffected by the dialog -->
    <SiteHeader transition:persist="header" />
    <slot />
    {footer && <SiteFooter />}

    <script>
      import Lenis from 'lenis';
      // Motion controller (survives view transitions; window persists). Owns
      // Lenis lifecycle so the reduce-motion toggle can stop/start smoothing at
      // runtime. data-motion is the single source of truth.
      type W = {
        __lenis?: { raf: (t: number) => void; destroy: () => void };
        __lenisRaf?: number;
        __applyMotion?: () => void;
      };
      const w = window as unknown as W;

      const startLenis = () => {
        if (w.__lenis) return;
        const lenis = new Lenis({ lerp: 0.085, smoothWheel: true, wheelMultiplier: 1 });
        const raf = (time: number) => { lenis.raf(time); w.__lenisRaf = requestAnimationFrame(raf); };
        w.__lenisRaf = requestAnimationFrame(raf);
        w.__lenis = lenis;
      };
      const stopLenis = () => {
        if (!w.__lenis) return;
        if (w.__lenisRaf) cancelAnimationFrame(w.__lenisRaf);
        try { w.__lenis.destroy(); } catch (e) {}
        w.__lenis = undefined;
      };
      const reducedMotion = () => {
        try {
          const o = localStorage.getItem('snds-motion');
          if (o === 'reduce') return true;
          if (o === 'full') return false;
        } catch (e) {}
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      };
      w.__applyMotion = () => {
        const reduced = reducedMotion();
        document.documentElement.dataset.motion = reduced ? 'reduce' : 'full';
        if (reduced) stopLenis(); else startLenis();
      };
      w.__applyMotion();
      document.addEventListener('astro:after-swap', () => w.__applyMotion?.());
    </script>
  </body>
</html>
