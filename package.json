{
  "name": "snds-portfolio",
  "private": true,
  "version": "0.0.0",
  "description": "SNDS portfolio — AI, LLMs, and design systems. Astro + R3F + Radix + vanilla-extract.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @snds/site",
    "build": "npm run build -w @snds/site",
    "preview": "npm run preview -w @snds/site",
    "test": "npm run test -w @snds/ui",
    "test:a11y": "playwright test",
    "a11y": "npm run build && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
